<?xml version="1.0" encoding="utf-8"?>
<!-- OFF state of a floating-menu toggle button: dim slate, violet edge. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#241B3D" />
            <stroke android:width="1dp" android:color="#7C3AED" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#140F24" />
            <stroke android:width="1dp" android:color="#332A52" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
