<?xml version="1.0" encoding="utf-8"?>
<!-- ON state of a floating-menu toggle button: neon cyan/green glow. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#6622D3EE" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="0"
                        android:endColor="#06B6D4"
                        android:startColor="#34D399"
                        android:type="linear" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#4D34D399" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="0"
                        android:endColor="#0891B2"
                        android:startColor="#34D399"
                        android:type="linear" />
                    <stroke android:width="1dp" android:color="#A7F3D0" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
