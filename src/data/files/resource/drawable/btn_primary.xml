<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#8022D3EE" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#6D28D9" android:centerColor="#4C1D95" android:endColor="#0E7490" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#6622D3EE" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <stroke android:width="1dp" android:color="#B14CFF" />
                    <corners android:radius="15dp" />
                </shape>
            </item>
            <item android:top="3dp" android:left="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#C026D3" android:centerColor="#8B5CF6" android:endColor="#22D3EE" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:top="3dp" android:left="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#59FFFFFF" android:centerColor="#14FFFFFF" android:endColor="#00000000" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
