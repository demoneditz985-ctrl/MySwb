<?xml version="1.0" encoding="utf-8"?>
<!-- Floating overlay menu for Shadow Injector.
     Inflated by FloatingService and shown through WindowManager.

     Both the collapsed icon and the expanded menu are draggable anywhere on
     screen: the icon is dragged by touching it, the menu is dragged by its
     title bar or by any empty part of the panel. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- ===================== COLLAPSED STATE (floating icon) ===================== -->
    <LinearLayout
        android:id="@+id/icon_holder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="4dp">

        <FrameLayout
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:background="@drawable/floating_icon_bg">

            <ImageView
                android:id="@+id/img_icon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:src="@drawable/floating_icon" />

        </FrameLayout>

    </LinearLayout>

    <!-- ===================== EXPANDED STATE (menu) ===================== -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="222dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/floating_bg"
        android:padding="8dp"
        android:visibility="gone">

        <!-- header: grip + title + HIDE + CLOSE  (drag handle) -->
        <LinearLayout
            android:id="@+id/panel_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/floating_header_bg"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="2dp"
                android:paddingRight="4dp"
                android:text="&#10247;"
                android:textColor="#6B5F8F"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:text="SHADOW MENU"
                android:textColor="#EDE9FE"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_hide"
                android:layout_width="30dp"
                android:layout_height="26dp"
                android:background="@drawable/floating_item_bg"
                android:gravity="center"
                android:text="&#8212;"
                android:textColor="#22D3EE"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_close"
                android:layout_width="30dp"
                android:layout_height="26dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/floating_item_bg"
                android:gravity="center"
                android:text="&#10005;"
                android:textColor="#FF4D6D"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Shizuku status row (tap to re-check) -->
        <TextView
            android:id="@+id/txt_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/floating_item_bg"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="SHIZUKU: CHECKING..."
            android:textColor="#8B80B8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- ===================== TOGGLE BUTTONS ===================== -->

        <LinearLayout
            android:id="@+id/btn1"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/toggle_off"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="12dp">

            <TextView
                android:id="@+id/lbl1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:text="BUTTON 1"
                android:textColor="#C9BEE8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/state1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFF"
                android:textColor="#7C6FA8"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn2"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/toggle_off"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="12dp">

            <TextView
                android:id="@+id/lbl2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:text="BUTTON 2"
                android:textColor="#C9BEE8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/state2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFF"
                android:textColor="#7C6FA8"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn3"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/toggle_off"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="12dp">

            <TextView
                android:id="@+id/lbl3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:text="BUTTON 3"
                android:textColor="#C9BEE8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/state3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFF"
                android:textColor="#7C6FA8"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn4"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/toggle_off"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="12dp">

            <TextView
                android:id="@+id/lbl4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:text="BUTTON 4"
                android:textColor="#C9BEE8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/state4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFF"
                android:textColor="#7C6FA8"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="drag the title bar to move"
            android:textColor="#4C4370"
            android:textSize="8sp" />

    </LinearLayout>

</FrameLayout>
