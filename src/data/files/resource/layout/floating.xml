<?xml version="1.0" encoding="utf-8"?>
<!-- Floating overlay menu for Shadow Injector.
     Inflated by FloatingService and shown through WindowManager. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- ===================== COLLAPSED STATE (floating icon) ===================== -->
    <LinearLayout
        android:id="@+id/icon_holder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="4dp">

        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/floating_icon_bg">

            <ImageView
                android:id="@+id/img_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:src="@drawable/floating_icon" />

        </FrameLayout>

    </LinearLayout>

    <!-- ===================== EXPANDED STATE (menu) ===================== -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="212dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/floating_bg"
        android:padding="8dp"
        android:visibility="gone">

        <!-- header: title + HIDE + CLOSE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/floating_header_bg"
            android:paddingLeft="10dp"
            android:paddingRight="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:text="SHADOW MENU"
                android:textColor="#EDE9FE"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_hide"
                android:layout_width="28dp"
                android:layout_height="24dp"
                android:background="@drawable/floating_item_bg"
                android:gravity="center"
                android:text="&#8212;"
                android:textColor="#22D3EE"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_close"
                android:layout_width="28dp"
                android:layout_height="24dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/floating_item_bg"
                android:gravity="center"
                android:text="&#10005;"
                android:textColor="#FF4D6D"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Shizuku status row (tap to re-check) -->
        <TextView
            android:id="@+id/txt_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/floating_item_bg"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="SHIZUKU: CHECKING..."
            android:textColor="#8B80B8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- menu buttons -->
        <TextView
            android:id="@+id/btn1"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/floating_item_bg"
            android:gravity="center"
            android:text="BUTTON 1"
            android:textColor="#EDE9FE"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn2"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/floating_item_bg"
            android:gravity="center"
            android:text="BUTTON 2"
            android:textColor="#EDE9FE"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn3"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/floating_item_bg"
            android:gravity="center"
            android:text="BUTTON 3"
            android:textColor="#EDE9FE"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn4"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/floating_item_bg"
            android:gravity="center"
            android:text="BUTTON 4"
            android:textColor="#EDE9FE"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
